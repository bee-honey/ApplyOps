# Copy to .env (gitignored). Defaults match infra/docker-compose.yml for local dev.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
DB_HOST=localhost
DB_PORT=5432
DB_NAME=applyops
DB_USER=applyops
DB_PASSWORD=applyops

# M1: Gmail discovery. Run `make gmail-auth` once, then enable the schedule.
GMAIL_CREDENTIALS_FILE=data/gmail-credentials.json
GMAIL_TOKEN_DIR=data/gmail-token
DISCOVERY_SCHEDULE_ENABLED=false
DISCOVERY_INTERVAL=15m

# Later milestones
# TELEGRAM_BOT_TOKEN=                                   # M4
# TELEGRAM_ALLOWED_CHAT_IDS=                            # M4
# LLM_API_KEY=                                          # M2 (provider TBD)
